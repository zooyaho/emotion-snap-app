{
  "expo": {
    "name": "emotion-snap-app",
    "slug": "emotion-snap-app",
    "scheme": "emotionsnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/light-splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/dark-splash-screen.png",
        "resizeMode": "contain",
        "backgroundColor": "#141417"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zooyaho.emotionsnapapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.zooyaho.emotionsnapapp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ]
  }
}
