{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "types": ["nativewind/types"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["app/*"],
      "@assets/*": ["assets/*"],
      "@components/*": ["components/*"],
      "@providers/*": ["providers/*"],
      "@styles/*": ["styles/*"],
      "@constants/*": ["constants/*"],
      "@features/*": ["features/*"],
      "@utils/*": ["utils/*"],
      "@types/*": ["types/*"],
      "@hooks/*": ["hooks/*"],
      "@navigation/*": ["navigation/*"]
    }
  }
}
